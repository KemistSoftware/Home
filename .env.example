# Early-access sign-ups. Set ONE of the options below in the Vercel
# project settings, otherwise /api/subscribe returns 501 and the form
# falls back to opening a mail draft (no address is ever lost silently).

# Option A - post each sign-up to any endpoint you control
# SUBSCRIBE_WEBHOOK_URL=https://hooks.example.com/kemist

# Option B - email each sign-up to yourself via Resend
# RESEND_API_KEY=re_xxxxxxxxxxxx
# NOTIFY_EMAIL=admin@kemist.in
